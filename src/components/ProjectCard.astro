---
// ProjectCard.astro
interface Props {
  title: string;
  description: string;
  url: string;
  tags: string[];
  featured?: boolean;
}

const { title, description, url, tags, featured = false } = Astro.props;
---

<a href={url} target="_blank" rel="noopener noreferrer" class={`project-card card ${featured ? 'featured' : ''}`}>
  <div class="project-header">
    <div class="project-icon">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
        <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
      </svg>
    </div>
    <div class="project-title-group">
      <h3 class="project-title">{title}</h3>
      {featured && <span class="badge badge-emerald">Featured</span>}
    </div>
    <div class="project-arrow">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="7" y1="17" x2="17" y2="7"></line>
        <polyline points="7 7 17 7 17 17"></polyline>
      </svg>
    </div>
  </div>

  <p class="project-desc">{description}</p>

  <div class="project-tags">
    {tags.map((tag) => (
      <span class="tag">{tag}</span>
    ))}
  </div>
</a>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    text-decoration: none !important;
    color: inherit;
    gap: 0.85rem;
    height: 100%;
  }

  .project-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .project-icon {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    background-color: var(--accent-light);
    color: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .project-title-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex: 1;
    flex-wrap: wrap;
  }

  .project-title {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .project-card:hover .project-title {
    color: var(--accent);
  }

  .project-arrow {
    color: var(--text-muted);
    transition: transform var(--transition-fast), color var(--transition-fast);
  }

  .project-card:hover .project-arrow {
    transform: translate(2px, -2px);
    color: var(--accent);
  }

  .project-desc {
    margin-bottom: 0;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--text-secondary);
    flex: 1;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: auto;
  }

  .tag {
    font-size: 0.75rem;
    padding: 0.15rem 0.5rem;
    background-color: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    font-weight: 500;
  }
</style>
