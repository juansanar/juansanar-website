---
// ExperienceTimeline.astro
const experiences = [
  {
    company: "BenchSci",
    companyUrl: "https://www.benchsci.com/",
    logoText: "BS",
    roles: [
      {
        title: "Data Scientist",
        period: "2025 – Present",
        isCurrent: true,
        description: "Architecting AI-driven data intelligence pipelines and hardening extraction systems to deliver high-throughput API endpoints to support agentic preclinical biomedical acceleration.",
        tags: ["Generative AI", "Python", "Data Intelligence", "API Engineering", "Agentic AI"]
      },
      {
        title: "Science Tech Lead and Team Lead",
        period: "2023 – 2025",
        isCurrent: false,
        description: "Led multidisciplinary teams and directed technical strategy to improve the observability and scientific quality of data pipelines. Engineered comprehensive analytics frameworks to evaluate disease relations across journal articles (MONDO, ICD-10, SNOMED), ensuring robust data quality metrics and standards. Partnered with cross-functional stakeholders (Product, Engineering) to align scientific requirements with shared technical execution and delivery.",
        tags: ["Technical Leadership", "Biomedical Data", "Pipeline Architecture", "Disease Ontologies"]
      },
      {
        title: "Scientist II - Data Extraction",
        period: "2022 – 2023",
        isCurrent: false,
        description: "Developed and optimized biomedical data extraction workflows to enhance precision and data quality.",
        tags: ["Data Extraction", "Biomedical Science", "Data Quality"]
      }
    ]
  },
  {
    company: "University of Victoria",
    companyUrl: "https://www.uvic.ca/medsci/",
    logoText: "UV",
    roles: [
      {
        title: "Postdoctoral Research Fellow",
        subtitle: "Health Research BC Research Trainee",
        period: "2020 – 2022",
        isCurrent: false,
        description: "Led the design of a holistic and culturally safe translational research project to investigate an arrhythmia-causing genetic variant identified in the Gitxsan First Nation. Managed complex genomic and transcriptomic datasets using advanced bioinformatics (R, Bioconductor) to discover mechanisms underlying cardiomyocyte and neuronal calcium homeostasis.",
        tags: ["Translational Research", "Bioinformatics", "Genomics", "R / Bioconductor"]
      },
      {
        title: "Graduate Research Assistant",
        subtitle: "Division of Medical Sciences",
        period: "2015 – 2020",
        isCurrent: false,
        description: "Engineered conditional knockout mouse models and optimized primary neuronal cultures to investigate mechanisms of dendritic spine plasticity and cerebral cortex development. Developed advanced microscopy methods to visualize cellular dynamics and established accessible bio-image analysis frameworks for the research community.",
        tags: ["Neuroscience", "Microscopy", "Cellular Dynamics", "Open Science"]
      }
    ]
  },
  {
    company: "Medical Education & Teaching",
    companyUrl: null,
    logoText: "MED",
    roles: [
      {
        title: "Teaching Assistant",
        subtitle: "Island Medical Program, UBC | University of Victoria",
        period: "2017 – 2020",
        isCurrent: false,
        description: "Instructed first- and second-year medical trainees in neuroanatomy laboratory sessions (MEDD412, MEDD421, MEDD422), fostering a dynamic educational space centered on the functional integration of clinical signs with neural structures and physiological processes.",
        tags: ["Medical Education", "Neuroanatomy", "UBC IMP"]
      }
    ]
  },
  {
    company: "Clinical Training & Early Research",
    companyUrl: null,
    logoText: "HUV",
    roles: [
      {
        title: "Pre-Diploma Medical Intern (Internado Rotatorio)",
        subtitle: "Hospital Universitario del Valle ESE | Universidad del Valle",
        period: "2013 – 2014",
        isCurrent: false,
        description: "Completed clinical rotations across Internal Medicine, Paediatrics, Obstetrics and Gynaecology, Specialized Research Internship in Biomedical Science (Neuroscience Research), Surgery, and Family Medicine."
      },
      {
        title: "Observership: Functional Neurosurgery",
        subtitle: "University of Illinois Hospital & Health Sciences System, Chicago IL",
        period: "2014",
        isCurrent: false,
        description: "Clinical observership under the supervision of Dr. Konstantin Slavin."
      },
      {
        title: "Undergraduate Medical Researcher",
        subtitle: "Centro de Estudios Cerebrales & School of Public Health, Universidad del Valle",
        period: "2010 – 2014",
        isCurrent: false,
        description: "Refined experimental procedures for modeling diffuse traumatic brain injury (organotypic brain tissue preparations) and coordinated regional surveys assessing cardiovascular risk factors in spinal cord injury patients."
      }
    ]
  }
];
---

<div class="experience-timeline">
  {experiences.map((exp) => (
    <div class="company-card card">
      <div class="company-header">
        <div class="company-info">
          <div class="company-badge">{exp.logoText}</div>
          <div>
            <h3 class="company-name">
              {exp.companyUrl ? (
                <a href={exp.companyUrl} target="_blank" rel="noopener noreferrer">
                  {exp.company}
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="external-icon">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                    <polyline points="15 3 21 3 21 9"></polyline>
                    <line x1="10" y1="14" x2="21" y2="3"></line>
                  </svg>
                </a>
              ) : (
                <span>{exp.company}</span>
              )}
            </h3>
          </div>
        </div>
      </div>

      <div class="roles-list">
        {exp.roles.map((role) => (
          <div class="role-item">
            <div class="role-header">
              <div class="role-title-group">
                <span class="role-title">{role.title}</span>
                {role.subtitle && <span class="role-subtitle">({role.subtitle})</span>}
                {role.isCurrent && <span class="badge badge-emerald">Current</span>}
              </div>
              <span class="role-period">{role.period}</span>
            </div>

            {role.description && <p class="role-desc">{role.description}</p>}

            {role.tags && role.tags.length > 0 && (
              <div class="role-tags">
                {role.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  ))}
</div>

<style>
  .experience-timeline {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .company-card {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .company-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .company-info {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .company-badge {
    width: 38px;
    height: 38px;
    border-radius: var(--radius-md);
    background: var(--accent-light);
    color: var(--accent);
    font-weight: 700;
    font-size: 0.85rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border-subtle);
  }

  .company-name {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 700;
  }

  .company-name a {
    color: var(--text-primary);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .company-name a:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .external-icon {
    opacity: 0.6;
    transition: opacity var(--transition-fast);
  }

  .company-name a:hover .external-icon {
    opacity: 1;
  }

  .roles-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding-left: 0.5rem;
    border-left: 2px solid var(--border-subtle);
    margin-left: 1.15rem;
  }

  .role-item {
    position: relative;
    padding-left: 1.25rem;
  }

  .role-item::before {
    content: '';
    position: absolute;
    left: -0.6rem;
    top: 0.4rem;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--accent);
    border: 2px solid var(--bg-surface);
  }

  .role-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 0.35rem;
    flex-wrap: wrap;
  }

  .role-title-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .role-title {
    font-weight: 600;
    color: var(--text-primary);
    font-size: 1.05rem;
  }

  .role-subtitle {
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .role-period {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 500;
    white-space: nowrap;
  }

  .role-desc {
    margin-bottom: 0.6rem;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .role-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag {
    font-size: 0.75rem;
    padding: 0.15rem 0.5rem;
    background-color: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    font-weight: 500;
  }

  @media (max-width: 640px) {
    .role-header {
      flex-direction: column;
      gap: 0.2rem;
    }
  }
</style>
