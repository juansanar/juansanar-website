---
// EducationCard.astro
const education = [
  {
    institution: "University of Victoria",
    location: "Victoria, BC, Canada",
    degree: "Ph.D. in Neuroscience",
    period: "Jan 2015 – Apr 2020",
    description: "Doctoral research in cellular and molecular neuroscience, synaptic plasticity, and advanced biological imaging."
  },
  {
    institution: "Universidad del Valle, School of Medicine",
    location: "Cali, Valle, Colombia",
    degree: "Doctor in Medicine (MD)",
    period: "Aug 2007 – Sep 2014",
    description: "Medical training with clinical rotations across hospital medicine, emergency care, and biomedical research."
  }
];
---

<div class="education-grid">
  {education.map((item) => (
    <div class="card edu-card">
      <div class="edu-header">
        <div>
          <h3 class="edu-degree">{item.degree}</h3>
          <p class="edu-institution">{item.institution}</p>
        </div>
        <span class="edu-period">{item.period}</span>
      </div>
      <p class="edu-location">{item.location}</p>
      <p class="edu-desc">{item.description}</p>
    </div>
  ))}
</div>

<style>
  .education-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.25rem;
  }

  .edu-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .edu-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
  }

  .edu-degree {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .edu-institution {
    margin: 0.2rem 0 0 0;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--accent);
  }

  .edu-period {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 500;
    white-space: nowrap;
  }

  .edu-location {
    margin: 0;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .edu-desc {
    margin-top: 0.5rem;
    margin-bottom: 0;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--text-secondary);
  }
</style>
