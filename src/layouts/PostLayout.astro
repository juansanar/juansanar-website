---
// PostLayout.astro
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  date: Date;
  author?: string;
  tags?: string[];
  image?: string;
}

const { title, description, date, author = "Juan C. Sanchez-Arias", tags = [], image } = Astro.props;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
}).format(date);
---

<BaseLayout title={title} description={description} image={image}>
  <article class="post-article">
    <div class="post-header">
      <a href="/blog" class="back-link">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        Back to all articles
      </a>

      <h1 class="post-title">{title}</h1>

      <div class="post-meta">
        <div class="meta-item">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          <time datetime={date.toISOString()}>{formattedDate}</time>
        </div>

        <div class="meta-item">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
          <span>{author}</span>
        </div>
      </div>

      {tags && tags.length > 0 && (
        <div class="post-tags">
          {tags.map((tag) => (
            <span class="badge">{tag}</span>
          ))}
        </div>
      )}
    </div>

    <div class="post-content markdown-body">
      <slot />
    </div>

    <div class="post-footer card">
      <div class="author-bio">
        <img src="/img/juansanar_pro-pic_02_165kb.jpg" alt="Juan C. Sanchez-Arias" class="author-avatar" />
        <div>
          <h4>Written by Juan C. Sanchez-Arias, MD, PhD</h4>
          <p>Data Scientist at BenchSci, Medical Doctor, neuroscientist, and Google-Certified GenAI Leader.</p>
        </div>
      </div>
      <a href="/blog" class="btn btn-secondary btn-sm">More Articles &rarr;</a>
    </div>
  </article>
</BaseLayout>

<style>
  .post-article {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    max-width: 760px;
    margin: 0 auto;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
    text-decoration: none !important;
  }

  .back-link:hover {
    color: var(--accent);
  }

  .post-title {
    margin-bottom: 1rem;
    font-size: clamp(2rem, 4vw, 2.75rem);
    line-height: 1.2;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  /* Markdown body typography */
  .markdown-body {
    color: var(--text-secondary);
    font-size: 1.075rem;
    line-height: 1.75;
  }

  .markdown-body :global(h1),
  .markdown-body :global(h2),
  .markdown-body :global(h3) {
    color: var(--text-primary);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .markdown-body :global(p) {
    margin-bottom: 1.25rem;
  }

  .markdown-body :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    margin: 1.5rem 0;
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-sm);
  }

  .markdown-body :global(pre) {
    background-color: var(--bg-surface-elevated) !important;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    overflow-x: auto;
    margin: 1.5rem 0;
    font-family: var(--font-mono);
    font-size: 0.9rem;
  }

  .markdown-body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.88em;
    padding: 0.15em 0.4em;
    border-radius: var(--radius-sm);
    background-color: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
  }

  .markdown-body :global(pre code) {
    padding: 0;
    background: transparent;
    border: none;
  }

  .markdown-body :global(blockquote) {
    border-left: 4px solid var(--accent);
    padding: 0.75rem 1.25rem;
    margin: 1.5rem 0;
    background-color: var(--accent-light);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    font-style: italic;
    color: var(--text-primary);
  }

  .markdown-body :global(ul), .markdown-body :global(ol) {
    margin: 1rem 0 1.5rem 1.5rem;
  }

  .markdown-body :global(li) {
    margin-bottom: 0.4rem;
  }

  .post-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 2rem;
    flex-wrap: wrap;
  }

  .author-bio {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .author-avatar {
    width: 54px;
    height: 54px;
    border-radius: var(--radius-full);
    object-fit: cover;
    border: 2px solid var(--accent);
  }

  .author-bio h4 {
    margin: 0 0 0.2rem 0;
    font-size: 1rem;
  }

  .author-bio p {
    margin: 0;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
</style>
