---
// about.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
---

<BaseLayout
  title="About | Juan C. Sanchez-Arias, MD, PhD"
  description="Learn more about Juan C. Sanchez-Arias — Medical Doctor, neuroscientist, and Data Scientist at BenchSci."
>
  <div class="about-container">
    <div class="about-header">
      <div class="about-avatar-wrap">
        <img
          src="/img/juansanar_pro-pic_02_165kb.jpg"
          alt="Juan C. Sanchez-Arias"
          class="about-avatar"
        />
      </div>
      <div>
        <h1 class="about-title">About Me</h1>
        <p class="about-intro">
          Medical Doctor, neuroscientist, and data scientist with a passion for accelerating scientific discovery through artificial intelligence, computational biology, and open science.
        </p>
        <SocialLinks />
      </div>
    </div>

    <div class="about-content">
      <section class="about-block card">
        <h2>🔬 Scientific & Clinical Foundation</h2>
        <p>
          I started my career in medicine, earning my Medical Degree (MD) from <strong>Universidad del Valle</strong> in Colombia, where I completed clinical internships across internal medicine, surgery, pediatrics, and emergency departments.
        </p>
        <p>
          Driven by a curiosity for how complex biological networks form and fail, I moved to Canada to pursue a <strong>Ph.D. in Neuroscience</strong> at the <strong>University of Victoria</strong>. As a <strong>Michael Smith Health Research BC Fellow</strong> and postdoctoral researcher, my work investigated the cellular, molecular, and genetic mechanisms underlying neuronal circuit wiring and inherited cardiac arrhythmias in British Columbia using advanced confocal microscopy, image processing, and computational biology.
        </p>
      </section>

      <section class="about-block card">
        <h2>⚡ Data Science & AI Leadership</h2>
        <p>
          Today, as a <strong>Data Scientist</strong> and former <strong>Science Tech Lead</strong> at <a href="https://www.benchsci.com/" target="_blank" rel="noopener">BenchSci</a>, I design and harden AI-driven data intelligence pipelines and high-throughput services that empower preclinical scientists worldwide to navigate complex experimental history and therapeutics data.
        </p>
        <p>
          I am a <strong>Google-Certified Generative AI Leader</strong>, actively working at the intersection of large language models, evaluation frameworks, bio-image analysis automation, and data stewardship.
        </p>
      </section>

      <section class="about-block card">
        <h2>🌱 Community & Open Source</h2>
        <p>
          Beyond enterprise systems, I care deeply about building practical community tools. Projects like the <a href="https://victoriachildcarehub.ca" target="_blank" rel="noopener">Victoria Childcare Hub</a> demonstrate how open data and modern web engineering can solve real everyday challenges for families in British Columbia.
        </p>
        <p>
          In my spare time, I enjoy mentoring emerging scientists, exploring generative AI benchmarking, contributing to open science, and spending time outdoors in Victoria, BC.
        </p>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .about-container {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .about-header {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .about-avatar-wrap {
    flex-shrink: 0;
  }

  .about-avatar {
    width: 140px;
    height: 140px;
    border-radius: var(--radius-full);
    object-fit: cover;
    border: 3px solid var(--teal-primary);
    box-shadow: var(--shadow-md);
  }

  .about-title {
    margin-bottom: 0.5rem;
  }

  .about-intro {
    font-size: 1.125rem;
    color: var(--text-secondary);
    margin-bottom: 1rem;
    line-height: 1.55;
  }

  .about-content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .about-block {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .about-block h2 {
    margin-top: 0;
    font-size: 1.25rem;
    border-bottom: none;
    padding-bottom: 0;
  }

  .about-block p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 640px) {
    .about-header {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
