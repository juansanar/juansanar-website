<BaseLayout
  title="Curriculum Vitae & Resume | Juan C. Sanchez-Arias, MD, PhD"
  description="Official academic Curriculum Vitae and Industry Resume of Juan C. Sanchez-Arias, MD, PhD."
>
  <div class="cv-page">
    <!-- Header & Download Cards -->
    <div class="cv-hero">
      <div>
        <h1 class="page-title">Curriculum Vitae</h1>
        <p class="page-desc">
          Official academic Curriculum Vitae and industry-focused career record of Juan C. Sanchez-Arias, MD, PhD.
        </p>
      </div>

      <div class="download-cards">
        <div class="card download-card">
          <div class="card-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
              <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
          </div>
          <div>
            <h3>Academic Curriculum Vitae</h3>
            <p>Comprehensive 3-page record of publications, clinical training, research, and awards.</p>
          </div>
          <div class="action-btn-group">
            <a href="/files/juansanar_cv.pdf" download="Juan_Sanchez_Arias_CV.pdf" class="btn btn-primary btn-action">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              <span>Download PDF</span>
            </a>
            <a href="/files/juansanar_cv.pdf" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-action-sm">
              <span>Open ↗</span>
            </a>
          </div>
        </div>

        <div class="card download-card">
          <div class="card-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
              <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
            </svg>
          </div>
          <div>
            <h3>Industry Resume</h3>
            <p>Focused overview of Data Science, AI systems engineering, and technical leadership.</p>
          </div>
          <div class="action-btn-group">
            <a href="/files/juansanar_resume.pdf" download="Juan_Sanchez_Arias_Resume.pdf" class="btn btn-primary btn-action">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              <span>Download PDF</span>
            </a>
            <a href="/files/juansanar_resume.pdf" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-action-sm">
              <span>Open ↗</span>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Interactive CV Content Sections -->
    <div class="cv-sections-container">
      <!-- Education -->
      <section class="cv-section card">
        <h2 class="section-title">
          <span class="section-badge">🎓</span> Education
        </h2>
        <div class="cv-items-list">
          {education.map((edu) => (
            <div class="cv-item">
              <div class="cv-item-header">
                <div>
                  <h3 class="cv-item-title">{edu.degree}</h3>
                  <p class="cv-item-sub">{edu.institution} &bull; {edu.location}</p>
                </div>
                <span class="cv-period">{edu.period}</span>
              </div>
              <p class="cv-desc">{edu.description}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Work Experience -->
      <section class="cv-section card">
        <h2 class="section-title">
          <span class="section-badge">💼</span> Work Experience
        </h2>
        <div class="cv-items-list">
          {workExperience.map((job) => (
            <div class="cv-item">
              <div class="cv-item-header">
                <div>
                  <h3 class="cv-item-title">{job.title}</h3>
                  <p class="cv-item-sub">{job.company} &bull; {job.location}</p>
                </div>
                <span class="cv-period">{job.period}</span>
              </div>
              <ul class="cv-bullets">
                {job.bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <!-- Research Experience -->
      <section class="cv-section card">
        <h2 class="section-title">
          <span class="section-badge">🔬</span> Research Experience
        </h2>
        <div class="cv-items-list">
          {researchExperience.map((res) => (
            <div class="cv-item">
              <div class="cv-item-header">
                <div>
                  <h3 class="cv-item-title">{res.title}</h3>
                  <p class="cv-item-sub">{res.institution} &bull; {res.location}</p>
                </div>
                <span class="cv-period">{res.period}</span>
              </div>
              <ul class="cv-bullets">
                {res.bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <!-- Clinical Experiences -->
      <section class="cv-section card">
        <h2 class="section-title">
          <span class="section-badge">🏥</span> Relevant Clinical Experiences
        </h2>
        <div class="cv-items-list">
          {clinicalExperiences.map((clin) => (
            <div class="cv-item">
              <div class="cv-item-header">
                <div>
                  <h3 class="cv-item-title">{clin.title}</h3>
                  <p class="cv-item-sub">{clin.institution} &bull; {clin.location}</p>
                </div>
                <span class="cv-period">{clin.period}</span>
              </div>
              <p class="cv-desc">{clin.detail}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Teaching Experience -->
      <section class="cv-section card">
        <h2 class="section-title">
          <span class="section-badge">👨‍🏫</span> Medical Education & Teaching Experience
        </h2>
        <div class="cv-items-list">
          {teachingExperience.map((tea) => (
            <div class="cv-item">
              <div class="cv-item-header">
                <div>
                  <h3 class="cv-item-title">{tea.title}</h3>
                  <p class="cv-item-sub">{tea.institution} &bull; {tea.location}</p>
                </div>
                <span class="cv-period">{tea.period}</span>
              </div>
              <p class="course-name"><strong>{tea.course}</strong></p>
              <p class="cv-desc">{tea.description}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Selected Awards & Fellowships -->
      <section class="cv-section card">
        <h2 class="section-title">
          <span class="section-badge">🏆</span> Selected Awards & Fellowships
        </h2>

        <!-- Featured Spotlight -->
        <div class="award-spotlight">
          <div class="award-spotlight-header">
            <div>
              <div class="spotlight-tag">⭐ FEATURED RESEARCH AWARD</div>
              <h3 class="spotlight-title">Research Trainee Award</h3>
              <p class="spotlight-org">Michael Smith Health Research BC &bull; University of Victoria</p>
            </div>
            <span class="spotlight-period">2021 – 2022</span>
          </div>

          <div class="spotlight-project">
            <h4 class="project-title">
              The impact of the loss-of-function ankyrin-B p.S646F variant on cardiomyocyte and neuronal excitability: Implications for diagnosis and treatment of heart disease
            </h4>
            <p class="project-mentors">
              <strong>Mentors & Collaborators:</strong> Dr. Leigh Anne Swayne &amp; Dr. Laura Arbour (Division of Medical Sciences)
            </p>
            <p class="project-summary">
              Investigated the cellular and molecular mechanisms of a genetic variant in the <em>ANK2</em> gene (ankyrin-B p.S646F) identified in Indigenous Communities of Northern BC (Gitxsan Nation) associated with cardiac arrhythmias, structural cardiomyopathy, seizures, and cerebral aneurysms. Applied advanced fluorescence live-cell imaging of calcium and voltage dynamics along with computational modeling in immature heart and brain cells to bridge fundamental laboratory observations to patient electrocardiograms.
            </p>
          </div>

          <div class="spotlight-actions">
            <a
              href="https://www.healthresearchbc.ca/award-recipient/juan-sanchez-arias/"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-secondary btn-sm"
            >
              Health Research BC Profile ↗
            </a>
            <a
              href="https://www.healthresearchbc.ca/award/the-impact-of-the-loss-of-function-ankyrin-b-p-s646f-variant-on-cardiomyocyte-and-neuronal-excitability-implications-for-diagnosis-and-treatment-of-heart-disease/"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-secondary btn-sm"
            >
              Award Abstract ↗
            </a>
            <a
              href="https://web.archive.org/web/https://www.healthresearchbc.ca/award-recipient/juan-sanchez-arias/"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-secondary btn-sm"
            >
              Wayback Archive ↗
            </a>
          </div>
        </div>

        <div class="awards-grid">
          {awards.map((a) => (
            <div class="award-item">
              <div class="award-main">
                <span class="award-name">{a.award}</span>
                <span class="award-org">{a.organization}</span>
              </div>
              <span class="award-period">{a.period}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- Selected Publications -->
      <section class="cv-section card">
        <div class="section-header-flex">
          <h2 class="section-title">
            <span class="section-badge">📚</span> Selected Peer-Reviewed Publications
          </h2>
          <a
            href="https://scholar.google.com/citations?user=7i_d-ZAAAAAJ"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-secondary btn-sm"
