---
// index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import ProjectCard from '../components/ProjectCard.astro';
import EducationCard from '../components/EducationCard.astro';
---

<BaseLayout
  title="Juan C. Sanchez-Arias, MD, PhD | Medical Doctor, Scientist & Data Scientist"
  description="Personal website of Juan C. Sanchez-Arias, MD, PhD — Data Scientist at BenchSci, Medical Doctor, Neuroscientist, and Google-Certified Generative AI Leader."
>
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="hero-avatar-container">
      <img
        src="/img/juansanar_pro-pic_02_165kb.jpg"
        alt="Juan C. Sanchez-Arias"
        class="hero-avatar"
        width="160"
        height="160"
      />
      <div class="hero-status-badge">
        <span class="status-indicator"></span>
        <span>Building AI Systems</span>
      </div>
    </div>

    <div class="hero-content">
      <div class="hero-badges">
        <span class="badge">Medical Doctor</span>
        <span class="badge">Scientist</span>
        <span class="badge badge-copper">Google-Certified GenAI Leader</span>
      </div>

      <h1 class="hero-title">
        Juan C. Sanchez-Arias <span class="pronouns">(he/him)</span> <span class="hero-flags" title="Colombian-Canadian" aria-label="Colombian and Canadian flags">🇨🇴 🇨🇦</span>
      </h1>

      <p class="hero-subtitle">
        <strong>Data Scientist</strong> at <a href="https://www.benchsci.com/" target="_blank" rel="noopener">BenchSci</a> &bull; Neuroscientist &bull; Medical Doctor
      </p>

      <p class="hero-tagline">
        Bridging medicine, computational biology, and AI-driven engineering to accelerate preclinical drug discovery and build empowering community tools.
      </p>

      <div class="hero-actions">
        <SocialLinks />
        <div class="cta-group">
          <a href="/files/juansanar_cv.pdf" target="_blank" class="btn btn-secondary btn-sm" title="View Curriculum Vitae">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
              <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
            CV
          </a>
          <a href="/files/juansanar_resume.pdf" target="_blank" class="btn btn-secondary btn-sm" title="View Resume">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            Resume
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Bio Section -->
  <section id="bio" class="section">
    <h2>
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="section-icon">
        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
        <circle cx="12" cy="7" r="4"></circle>
      </svg>
      About & Bio
    </h2>
    <div class="bio-card card">
      <p>
        <strong>Juan C. Sanchez-Arias, MD, PhD</strong> is a Medical Doctor, neuroscientist, and Google-Certified Generative AI Leader working as a <strong>Data Scientist</strong> at <a href="https://www.benchsci.com/" target="_blank" rel="noopener">BenchSci</a>. He bridges medicine, computational biology, and AI-driven engineering to accelerate and elevate preclinical drug discovery.
      </p>
      <p>
        Previously, he was a Health Research BC Postdoctoral Fellow in the Division of Medical Sciences at the University of Victoria, where his research combined advanced microscopy, model organism genetics, and computational tools to study brain and cardiac development. His interests span GenAI evaluation and benchmarking, biomedical data science, bio-image analysis, and open science. In his spare time, Juan develops community-focused tools, including the <a href="https://victoriachildcarehub.ca" target="_blank" rel="noopener">Victoria Childcare Hub</a>.
      </p>
    </div>
  </section>

  <!-- Experience Section -->
  <section id="experience" class="section">
    <h2>
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="section-icon">
        <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
        <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
      </svg>
      Experience
    </h2>
    <ExperienceTimeline />
  </section>

  <!-- Featured Projects -->
  <section id="projects" class="section">
    <h2>
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="section-icon">
        <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
        <polyline points="2 17 12 22 22 17"></polyline>
        <polyline points="2 12 12 17 22 12"></polyline>
      </svg>
      Community & Engineering Projects
    </h2>
    <div class="projects-grid">
      <ProjectCard
        title="Victoria Childcare Hub"
        description="A community platform leveraging AI-driven engineering and open data to help families discover, monitor, and navigate childcare availability across Greater Victoria, BC."
        url="https://victoriachildcarehub.ca"
        tags={["AI Engineering", "TypeScript", "Open Data", "Community"]}
        featured={true}
      />
    </div>
  </section>

  <!-- Education Section -->
  <section id="education" class="section">
    <h2>
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="section-icon">
        <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
        <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
      </svg>
      Education
    </h2>
    <EducationCard />
  </section>
</BaseLayout>

<style>
  /* Hero Section */
  .hero-section {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    padding: 1.5rem 0 2.5rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .hero-avatar-container {
    position: relative;
    flex-shrink: 0;
  }

  .hero-avatar {
    width: 150px;
    height: 150px;
    border-radius: var(--radius-full);
    object-fit: cover;
    border: 3px solid var(--teal-primary);
    box-shadow: var(--shadow-glow);
  }

  .hero-status-badge {
    position: absolute;
    bottom: -6px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    padding: 0.2rem 0.65rem;
    border-radius: var(--radius-full);
    font-size: 0.75rem;
    font-family: var(--font-heading);
    font-weight: 600;
    color: var(--text-secondary);
    white-space: nowrap;
    box-shadow: var(--shadow-sm);
  }

  .status-indicator {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background-color: #22c55e;
    box-shadow: 0 0 0 2px rgba(34, 197, 94, 0.3), 0 0 8px #22c55e;
    animation: status-pulse 2s infinite ease-in-out;
  }

  @keyframes status-pulse {
    0%, 100% {
      box-shadow: 0 0 0 2px rgba(34, 197, 94, 0.35), 0 0 6px #22c55e;
    }
    50% {
      box-shadow: 0 0 0 4px rgba(34, 197, 94, 0.15), 0 0 12px #22c55e;
    }
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex: 1;
  }

  .hero-badges {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .hero-title {
    margin: 0;
    font-size: clamp(1.75rem, 3.5vw, 2.35rem);
    font-weight: 800;
    line-height: 1.2;
    color: var(--text-primary);
  }

  .pronouns {
    font-size: 1rem;
    font-weight: 400;
    font-family: var(--font-sans);
    color: var(--text-muted);
  }

  .hero-flags {
    display: inline-block;
    font-size: 0.85em;
    vertical-align: middle;
    margin-left: 0.25rem;
    letter-spacing: 0.12em;
    user-select: none;
    cursor: default;
    transition: transform 0.2s ease;
  }

  .hero-flags:hover {
    transform: scale(1.15);
  }

  .hero-subtitle {
    margin: 0;
    font-size: 1.075rem;
    color: var(--text-primary);
  }

  .hero-tagline {
    margin: 0;
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.55;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }

  .cta-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .btn-sm {
    padding: 0.4rem 0.8rem;
    font-size: 0.85rem;
  }

  /* Section Styling */
  .section {
    margin-top: 2.5rem;
  }

  .section-icon {
    color: var(--accent);
  }

  .bio-card p:last-child {
    margin-bottom: 0;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.25rem;
  }

  @media (max-width: 680px) {
    .hero-section {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 1.5rem;
    }

    .hero-badges, .hero-actions, .cta-group {
      justify-content: center;
    }
  }
</style>
